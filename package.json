{
  "name": "floatnotes",
  "version": "1.1.1",
  "description": "Always-on-top floating notes app for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder build --mac",
    "launch": "npm run build && open dist/mac-arm64/FloatNotes.app",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.floatnote.app",
    "productName": "FloatNotes",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kristofbernal",
      "repo": "floatnotes"
    },
    "extraResources": [
      { "from": "resources/icon.png", "to": "icon.png" },
      { "from": "resources/compiled-icon/Assets.car", "to": "Assets.car" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/compiled-icon/FloatNotes Icon.icns",
      "extendInfo": {
        "CFBundleIconName": "FloatNotes Icon"
      },
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        },
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ]
    },
    "dmg": {
      "title": "FloatNotes",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/electron-liquid-glass/**/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "electron-liquid-glass": "^1.1.1",
    "electron-updater": "^6.8.3",
    "marked": "^17.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@rmccue/sfsymbols": "^0.0.2",
    "electron": "^40.6.1",
    "electron-builder": "^25.1.8"
  }
}
